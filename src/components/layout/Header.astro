---
// src/components/layout/Header.astro
import FuwariProfile from "@components/FuwariProfile.astro";
import SearchBar from "@components/widgets/SearchBar.astro"; 
---

<style>
  @import url('https://fonts.googleapis.com/css2?family=Grand+Hotel&display=swap');
  .ins-logo-font {
    font-family: 'Grand Hotel', cursive, system-ui, -apple-system, sans-serif;
  }
</style>

<!-- 移除 border-b 和 shadow，保持纯白一体 -->
<header class="w-full bg-base-100 sticky top-0 z-50 transition-all duration-200">
  <!-- 顶栏标题 + 搜索框 (去掉中间的分割线 border-b) -->
  <div class="w-full max-w-2xl mx-auto px-4 h-14 flex items-center justify-between">
    <div class="flex items-center space-x-2">
      <a href="/" class="text-xl sm:text-2xl font-bold tracking-normal ins-logo-font text-base-content hover:opacity-80 transition-opacity">
        サンpansir的随笔
      </a>
    </div>

    <div class="w-36 sm:w-48 flex justify-end items-center">
      <SearchBar />
    </div>
  </div>

  <!-- Ins Highlights 圆球列表 -->
  <div class="w-full max-w-2xl mx-auto">
    <FuwariProfile />
  </div>
</header>
