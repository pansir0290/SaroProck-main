---
export interface Props {
  siteTitle: string;
}

const { siteTitle } = Astro.props;
const SITE_DESCRIPTION = "一些随性的记录和不成熟的想法，漂浮在时间的河流里";
---

<header class="sticky top-0 z-50 w-full bg-base-100/80 backdrop-blur-md border-b border-base-content/10 no-print">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-14 flex items-center justify-between gap-2">
    
    <!-- 左侧：Logo + 主标题 + 紧跟后边的副标题（同一行横排） -->
    <a href="/" class="flex items-center gap-1.5 sm:gap-2.5 min-w-0 flex-1 hover:opacity-80 transition-opacity">
      <!-- 枫叶 Logo -->
      <i class="ri-leaf-fill text-primary text-xl flex-shrink-0"></i>

      <!-- 标题 + 小字跟在后边 -->
      <div class="flex items-baseline gap-2 min-w-0 truncate">
        <span class="text-xs sm:text-sm font-bold tracking-tight text-base-content flex-shrink-0">
          {siteTitle}
        </span>
        <!-- 后边紧跟的小字（副标题） -->
        <span class="text-[10px] sm:text-xs text-base-content/50 font-light truncate">
          {SITE_DESCRIPTION}
        </span>
      </div>
    </a>

    <!-- 右侧：精简搜索框 -->
    <div class="flex items-center flex-shrink-0">
      <div class="relative flex items-center">
        <input
          type="text"
          placeholder="搜索..."
          class="w-20 xs:w-28 sm:w-36 h-7 text-[11px] sm:text-xs pl-6 pr-2 rounded-full bg-base-200/60 border border-base-content/10 focus:outline-none focus:border-primary focus:w-32 sm:focus:w-48 transition-all duration-300"
        />
        <i class="ri-search-line absolute left-2 text-xs text-base-content/40"></i>
      </div>
    </div>

  </div>
</header>
