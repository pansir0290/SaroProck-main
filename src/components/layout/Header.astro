---
// src/components/layout/Header.astro
import FuwariProfile from "@components/FuwariProfile.astro";
import SearchBar from "@components/widgets/SearchBar.astro"; 
---

<style>
  @import url('https://fonts.googleapis.com/css2?family=Grand+Hotel&display=swap');
  .ins-logo-font {
    font-family: 'Grand Hotel', cursive, system-ui, -apple-system, sans-serif;
  }
</style>

<header class="w-full bg-base-100">
  <!-- 
    精准往上提“半丢丢”：
    pt-7 sm:pt-9：顶部留白设为 28px（PC 端 36px），
    比之前的 pt-10 整体提上去了一小截，刚好抵消浏览器的部分底栏影响！
  -->
  <div class="w-full max-w-2xl mx-auto px-4 pt-7 pb-3 sm:pt-9 sm:pb-4">
    
    <!-- 顶栏标题 + 搜索框 -->
    <div class="w-full h-14 flex items-center justify-between mb-1.5">
      <div class="flex items-center space-x-2">
        <a href="/" class="text-2xl sm:text-3xl font-bold tracking-normal ins-logo-font text-base-content hover:opacity-80 transition-opacity">
          サンpansir的随笔
        </a>
      </div>

      <div class="w-36 sm:w-48 flex justify-end items-center">
        <SearchBar />
      </div>
    </div>

    <!-- Ins Highlights 圆球列表 -->
    <div class="w-full">
      <FuwariProfile />
    </div>

  </div>
</header>
