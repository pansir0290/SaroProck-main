---
export interface Props {
  author: string;
  twitterHandle: string;
  githubUrl: string;
  telegramUrl: string;
}

const { author, twitterHandle, githubUrl, telegramUrl } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-base-200/50 border-t border-base-content/10 py-8 mt-12 no-print">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    
    <!-- 顶部：寄语与赞赏 (电脑端左右分栏，手机端居中) -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <p class="text-xs sm:text-sm text-base-content/70 leading-relaxed max-w-xl">
        感谢你的停留至此，希望这里的文字能为你带来片刻的宁静或思考。
      </p>
      <button class="btn btn-xs sm:btn-sm btn-outline rounded-full text-[11px] sm:text-xs font-normal hover:bg-primary hover:border-primary shrink-0">
        <i class="ri-heart-3-line text-red-500"></i>
        喜欢本站
      </button>
    </div>

    <div class="border-t border-base-content/5 pt-6">
      <!-- 核心区域：关注与二维码 (电脑端右对齐分栏，手机端居中对齐) -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
        
        <!-- 关注链接：手机端 2x2 布局，电脑端单行/双行横排 -->
        <div class="space-y-2 text-center sm:text-left w-full sm:w-auto">
          <h4 class="text-xs font-bold text-base-content/90 tracking-wider">关注与订阅</h4>
          <div class="grid grid-cols-2 sm:flex sm:flex-wrap items-center gap-2 sm:gap-4 text-[11px] sm:text-xs text-base-content/70">
            <a href={`https://x.com/${twitterHandle.replace('@','')}`} target="_blank" rel="noreferrer" class="hover:text-primary transition-colors flex items-center justify-center sm:justify-start gap-1 bg-base-100 sm:bg-transparent py-1.5 sm:py-0 px-2 sm:px-0 rounded-md border border-base-content/5 sm:border-none">
              <i class="ri-twitter-x-line text-xs"></i> <span>Twitter</span>
            </a>
            <a href={githubUrl} target="_blank" rel="noreferrer" class="hover:text-primary transition-colors flex items-center justify-center sm:justify-start gap-1 bg-base-100 sm:bg-transparent py-1.5 sm:py-0 px-2 sm:px-0 rounded-md border border-base-content/5 sm:border-none">
              <i class="ri-github-line text-xs"></i> <span>GitHub</span>
            </a>
            <a href={telegramUrl} target="_blank" rel="noreferrer" class="hover:text-primary transition-colors flex items-center justify-center sm:justify-start gap-1 bg-base-100 sm:bg-transparent py-1.5 sm:py-0 px-2 sm:px-0 rounded-md border border-base-content/5 sm:border-none">
              <i class="ri-telegram-line text-xs"></i> <span>Telegram</span>
            </a>
            <a href="/rss.xml" class="hover:text-primary transition-colors flex items-center justify-center sm:justify-start gap-1 bg-base-100 sm:bg-transparent py-1.5 sm:py-0 px-2 sm:px-0 rounded-md border border-base-content/5 sm:border-none">
              <i class="ri-rss-line text-xs"></i> <span>RSS</span>
            </a>
          </div>
        </div>

        <!-- 二维码模块 -->
        <div class="flex items-center gap-3 bg-base-100 sm:bg-transparent p-2 sm:p-0 rounded-xl border border-base-content/5 sm:border-none shrink-0">
          <div class="w-14 h-14 sm:w-16 sm:h-16 p-1 bg-white rounded-lg shadow-sm border border-base-content/10 overflow-hidden flex items-center justify-center shrink-0">
            <img 
              src="/qrcode.png" 
              alt="Telegram QR Code" 
              class="w-full h-full object-contain"
              onerror="this.onerror=null; this.src='https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=https://t.me/pansir029';"
            />
          </div>
          <div class="text-left space-y-0.5">
            <p class="text-[11px] font-medium text-base-content/80">扫码关注 Telegram</p>
            <p class="text-[9px] text-base-content/40">获取频道最新消息推送</p>
          </div>
        </div>

      </div>
    </div>

    <!-- 版权声明（绝对居中） -->
    <div class="pt-4 border-t border-base-content/5 text-[10px] sm:text-[11px] text-base-content/50 space-y-0.5 text-center">
      <p>© {currentYear} {author}. All rights reserved.</p>
      <p>用 Astro 构建，原作者 EveSunMaple</p>
    </div>

  </div>
</footer>
