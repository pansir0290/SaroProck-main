---
import type { MarkdownHeading } from "astro";
import { getCollection } from "astro:content";
import TOC from "@components/blog/TOC.astro";

export interface Props {
  author: string;
  twitterHandle: string;
  githubUrl: string;
  telegramUrl: string;
  headings?: MarkdownHeading[];
}

const { headings } = Astro.props;

// 动态统计数据计算
const allPosts = await getCollection("blog", ({ data }) => data.draft !== true);
const countWords = (text: string) => {
  text = text.replace(/[\u3000-\u303F\uFF00-\uFFEF]/g, "");
  text = text.replace(/[`*~_#+\-!\[\]{}()>|]/g, "");
  const cjkChars = text.match(/[\u4e00-\u9fa5]/g)?.length || 0;
  const otherWords =
    text.replace(/[\u4e00-\u9fa5]/g, " ").match(/\b\w+\b/g)?.length || 0;
  return cjkChars + otherWords;
};
const totalWords = allPosts.reduce(
  (acc, post) => acc + countWords(post.body),
  0,
);
const formattedTotalWords =
  totalWords > 1000 ? `${(totalWords / 1000).toFixed(1)}k` : totalWords;
const stats = {
  articles: allPosts.length,
  words: formattedTotalWords,
};

const QQ_GROUP_NUMBER = "34310889";
const EMAIL_ADDRESS = "pansir029@gmail.com";
---

<aside class="lg:col-span-1 no-print">
  <div class="sticky top-20">
    {
      headings && headings.length > 0 ? (
        <TOC headings={headings} />
      ) : (
        /* 右侧悬浮卡片：包含频道、统计与联系方式 */
        <div class="bg-base-200/40 backdrop-blur-md rounded-2xl p-4 border border-base-content/10 shadow-sm space-y-4">
          
          <!-- 1. 我的频道 -->
          <div>
            <div class="text-xs font-semibold uppercase text-base-content/60 mb-2 flex items-center">
              <i class="ri-telegram-line mr-1.5 text-primary text-sm"></i>
              我的频道
            </div>
            <div class="relative flex items-center bg-base-100/80 rounded-xl p-2 border border-base-content/10">
              <i class="ri-telegram-fill text-primary ml-1 mr-2 text-base"></i>
              <span id="telegram-channel-link" class="text-xs font-mono text-base-content/80 select-all">
                @allfree123
              </span>
              <button
                id="copy-channel-btn"
                type="button"
                class="btn btn-ghost btn-xs btn-circle absolute right-1 hover:text-primary"
                aria-label="复制频道地址"
              >
                <i class="ri-file-copy-fill copy-icon"></i>
                <i class="ri-check-line success-icon hidden text-emerald-500"></i>
              </button>
            </div>
          </div>

          <div class="border-t border-base-content/10"></div>

          <!-- 2. 站点统计 -->
          <div>
            <div class="text-xs font-semibold uppercase text-base-content/60 mb-2.5 flex items-center">
              <i class="ri-bar-chart-box-line mr-1.5 text-primary text-sm"></i>
              站点统计
            </div>
            <div class="grid grid-cols-2 gap-2 text-center">
              <div class="bg-base-100/60 rounded-xl p-2 border border-base-content/5">
                <p class="text-lg font-bold leading-tight text-base-content/90">{stats.articles}</p>
                <p class="text-[10px] text-base-content/60 mt-0.5">篇文章</p>
              </div>
              <div class="bg-base-100/60 rounded-xl p-2 border border-base-content/5">
                <p class="text-lg font-bold leading-tight text-base-content/90">{stats.words}</p>
                <p class="text-[10px] text-base-content/60 mt-0.5">总字数</p>
              </div>
            </div>
          </div>

          <div class="border-t border-base-content/10"></div>

          <!-- 3. 联系方式 -->
          <div>
            <div class="text-xs font-semibold uppercase text-base-content/60 mb-2.5 flex items-center">
              <i class="ri-contacts-line mr-1.5 text-primary text-sm"></i>
              联系方式
            </div>
            <div class="grid grid-cols-2 gap-2">
              <button
                id="copy-qq-btn"
                class="btn btn-xs btn-outline rounded-lg font-normal border-base-content/20 hover:border-primary hover:bg-primary hover:text-primary-content"
                data-qq-number={QQ_GROUP_NUMBER}
              >
                <i class="ri-qq-line"></i>
                复制QQ
              </button>
              <a
                href={`mailto:${EMAIL_ADDRESS}`}
                class="btn btn-xs btn-outline rounded-lg font-normal border-base-content/20 hover:border-primary hover:bg-primary hover:text-primary-content"
              >
                <i class="ri-mail-send-line"></i>
                发邮件
              </a>
            </div>
          </div>

        </div>
      )
    }
  </div>
</aside>

<script define:vars={{ QQ_GROUP_NUMBER }}>
  const initSidebar = () => {
    const copyChannelBtn = document.getElementById("copy-channel-btn");
    const channelLinkElement = document.getElementById("telegram-channel-link");

    if (copyChannelBtn && channelLinkElement) {
      const copyIcon = copyChannelBtn.querySelector(".copy-icon");
      const successIcon = copyChannelBtn.querySelector(".success-icon");

      copyChannelBtn.addEventListener("click", async () => {
        const textToCopy = channelLinkElement.textContent;
        if (!textToCopy || !copyIcon || !successIcon) return;
        try {
          await navigator.clipboard.writeText(textToCopy.trim());
          copyIcon.classList.add("hidden");
          successIcon.classList.remove("hidden");
          setTimeout(() => {
            successIcon.classList.add("hidden");
            copyIcon.classList.remove("hidden");
          }, 2000);
        } catch (err) {
          console.error("无法复制频道地址:", err);
        }
      });
    }

    const copyQqBtn = document.getElementById("copy-qq-btn");
    if (copyQqBtn) {
      const originalText = copyQqBtn.innerHTML;

      copyQqBtn.addEventListener("click", () => {
        if (!QQ_GROUP_NUMBER) return;

        navigator.clipboard
          .writeText(QQ_GROUP_NUMBER)
          .then(() => {
            copyQqBtn.innerHTML = '<i class="ri-check-line"></i> 成功';
            copyQqBtn.classList.add("btn-success");
            setTimeout(() => {
              copyQqBtn.innerHTML = originalText;
              copyQqBtn.classList.remove("btn-success");
            }, 2000);
          })
          .catch((err) => {
            console.error("无法复制QQ号: ", err);
            copyQqBtn.innerHTML = '<i class="ri-close-line"></i> 失败';
            copyQqBtn.classList.add("btn-error");
            setTimeout(() => {
              copyQqBtn.innerHTML = originalText;
              copyQqBtn.classList.remove("btn-error");
            }, 2000);
          });
      });
    }
  };

  document.addEventListener("DOMContentLoaded", initSidebar);
  document.addEventListener("astro:after-swap", initSidebar);
</script>
