---
import type { MarkdownHeading } from "astro";
import { getCollection } from "astro:content";
import TOC from "@components/blog/TOC.astro";

export interface Props {
  author: string;
  twitterHandle: string;
  githubUrl: string;
  telegramUrl: string;
  headings?: MarkdownHeading[];
}

const { headings } = Astro.props;

// 动态统计数据计算
const allPosts = await getCollection("blog", ({ data }) => data.draft !== true);
const countWords = (text: string) => {
  text = text.replace(/[\u3000-\u303F\uFF00-\uFFEF]/g, "");
  text = text.replace(/[`*~_#+\-!\[\]{}()>|]/g, "");
  const cjkChars = text.match(/[\u4e00-\u9fa5]/g)?.length || 0;
  const otherWords =
    text.replace(/[\u4e00-\u9fa5]/g, " ").match(/\b\w+\b/g)?.length || 0;
  return cjkChars + otherWords;
};
const totalWords = allPosts.reduce(
  (acc, post) => acc + countWords(post.body),
  0,
);
const formattedTotalWords =
  totalWords > 1000 ? `${(totalWords / 1000).toFixed(1)}k` : totalWords;
const stats = {
  articles: allPosts.length,
  words: formattedTotalWords,
};

const QQ_GROUP_NUMBER = "34310889";
const EMAIL_ADDRESS = "pansir029@gmail.com";
---

<aside class="lg:col-span-1 no-print">
  <div class="sticky top-20">
    {
      headings && headings.length > 0 ? (
        <TOC headings={headings} />
      ) : (
        /* 极致紧凑型单卡片 */
        <div class="bg-base-200/40 backdrop-blur-md rounded-2xl p-3 border border-base-content/10 shadow-sm space-y-3">
          
          <!-- 1. 站点数据（左右双列极简排版） -->
          <div class="grid grid-cols-2 gap-2 text-center">
            <div class="flex items-center justify-center gap-2 bg-base-100/60 rounded-xl p-2 border border-base-content/5">
              <i class="ri-article-line text-lg text-primary"></i>
              <div class="text-left leading-none">
                <p class="text-sm font-bold text-base-content">{stats.articles}</p>
                <p class="text-[10px] text-base-content/50 scale-90 -ml-1">文章</p>
              </div>
            </div>
            <div class="flex items-center justify-center gap-2 bg-base-100/60 rounded-xl p-2 border border-base-content/5">
              <i class="ri-file-word-2-line text-lg text-primary"></i>
              <div class="text-left leading-none">
                <p class="text-sm font-bold text-base-content">{stats.words}</p>
                <p class="text-[10px] text-base-content/50 scale-90 -ml-1">总字数</p>
              </div>
            </div>
          </div>

          <!-- 2. 频道与联系方式整合（三列网格布局，高密度展示） -->
          <div>
            <div class="text-[11px] font-semibold uppercase text-base-content/50 mb-1.5 px-1 flex items-center">
              <i class="ri-links-line mr-1 text-primary"></i>
              频道与联系
            </div>
            
            <!-- Telegram 频道条目 -->
            <div class="relative flex items-center justify-between bg-base-100/80 rounded-xl px-2.5 py-1.5 border border-base-content/10 mb-1.5">
              <div class="flex items-center gap-1.5 overflow-hidden">
                <i class="ri-telegram-fill text-primary text-sm flex-shrink-0"></i>
                <span id="telegram-channel-link" class="text-xs font-mono text-base-content/80 truncate">
                  @allfree123
                </span>
              </div>
              <button
                id="copy-channel-btn"
                type="button"
                class="btn btn-ghost btn-xs btn-circle hover:text-primary flex-shrink-0"
                aria-label="复制频道"
              >
                <i class="ri-file-copy-fill copy-icon text-xs"></i>
                <i class="ri-check-line success-icon hidden text-emerald-500 text-xs"></i>
              </button>
            </div>

            <!-- 快捷按钮左右并排 -->
            <div class="grid grid-cols-2 gap-1.5">
              <button
                id="copy-qq-btn"
                class="btn btn-xs btn-outline rounded-lg font-normal text-[11px] h-7 min-h-0 border-base-content/15 hover:border-primary hover:bg-primary hover:text-primary-content"
                data-qq-number={QQ_GROUP_NUMBER}
              >
                <i class="ri-qq-line"></i>
                复制QQ
              </button>
              <a
                href={`mailto:${EMAIL_ADDRESS}`}
                class="btn btn-xs btn-outline rounded-lg font-normal text-[11px] h-7 min-h-0 border-base-content/15 hover:border-primary hover:bg-primary hover:text-primary-content"
              >
                <i class="ri-mail-send-line"></i>
                发邮件
              </a>
            </div>
          </div>

        </div>
      )
    }
  </div>
</aside>

<script define:vars={{ QQ_GROUP_NUMBER }}>
  const initSidebar = () => {
    const copyChannelBtn = document.getElementById("copy-channel-btn");
    const channelLinkElement = document.getElementById("telegram-channel-link");

    if (copyChannelBtn && channelLinkElement) {
      const copyIcon = copyChannelBtn.querySelector(".copy-icon");
      const successIcon = copyChannelBtn.querySelector(".success-icon");

      copyChannelBtn.addEventListener("click", async () => {
        const textToCopy = channelLinkElement.textContent;
        if (!textToCopy || !copyIcon || !successIcon) return;
        try {
          await navigator.clipboard.writeText(textToCopy.trim());
          copyIcon.classList.add("hidden");
          successIcon.classList.remove("hidden");
          setTimeout(() => {
            successIcon.classList.add("hidden");
            copyIcon.classList.remove("hidden");
          }, 2000);
        } catch (err) {
          console.error("无法复制频道地址:", err);
        }
      });
    }

    const copyQqBtn = document.getElementById("copy-qq-btn");
    if (copyQqBtn) {
      const originalText = copyQqBtn.innerHTML;

      copyQqBtn.addEventListener("click", () => {
        if (!QQ_GROUP_NUMBER) return;

        navigator.clipboard
          .writeText(QQ_GROUP_NUMBER)
          .then(() => {
            copyQqBtn.innerHTML = '<i class="ri-check-line"></i> 成功';
            copyQqBtn.classList.add("btn-success");
            setTimeout(() => {
              copyQqBtn.innerHTML = originalText;
              copyQqBtn.classList.remove("btn-success");
            }, 2000);
          })
          .catch((err) => {
            console.error("无法复制QQ号: ", err);
            copyQqBtn.innerHTML = '<i class="ri-close-line"></i> 失败';
            copyQqBtn.classList.add("btn-error");
            setTimeout(() => {
              copyQqBtn.innerHTML = originalText;
              copyQqBtn.classList.remove("btn-error");
            }, 2000);
          });
      });
    }
  };

  document.addEventListener("DOMContentLoaded", initSidebar);
  document.addEventListener("astro:after-swap", initSidebar);
</script>
