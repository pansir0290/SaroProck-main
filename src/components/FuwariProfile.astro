---
// src/components/FuwariProfile.astro
---
<div class="fuwari-card p-5 flex flex-col items-center text-center relative overflow-hidden">
  <!-- 头像区 (可自行修改头像路径) -->
  <div class="relative mb-3 group">
    <div class="w-20 h-20 rounded-full overflow-hidden border-2 border-[var(--primary-fuwari)] shadow-sm transition-transform duration-300 group-hover:scale-105">
      <img src="/avatar.png" alt="Avatar" class="w-full h-full object-cover" onerror="this.src='https://api.dicebear.com/7.x/bottts/svg?seed=pansir'" />
    </div>
    <span class="absolute bottom-0 right-0 w-3.5 h-3.5 bg-emerald-500 border-2 border-white dark:border-gray-800 rounded-full"></span>
  </div>

  <!-- 博主信息 -->
  <h2 class="text-lg font-bold tracking-tight">pansir</h2>
  <p class="text-xs text-base-content/60 mt-1">折腾不息 / 记录生活与技术</p>

  <!-- 社交快捷入口 -->
  <div class="flex items-center space-x-3 mt-4">
    <a href="https://github.com/pansir0290" target="_blank" class="p-2 rounded-lg bg-base-200/50 hover:text-[var(--primary-fuwari)] transition-all">
      <i class="ri-github-line text-base"></i>
    </a>
    <a href="https://t.me/pansir029" target="_blank" class="p-2 rounded-lg bg-base-200/50 hover:text-[var(--primary-fuwari)] transition-all">
      <i class="ri-telegram-line text-base"></i>
    </a>
    <a href="/rss.xml" class="p-2 rounded-lg bg-base-200/50 hover:text-[var(--primary-fuwari)] transition-all">
      <i class="ri-rss-line text-base"></i>
    </a>
  </div>
</div>
