---
// src/components/FuwariProfile.astro
const socialLinks = [
  {
    name: "TG 频道",
    icon: "ri-telegram-fill",
    color: "from-sky-400 to-blue-500",
    link: "https://t.me/pansir029",
  },
  {
    name: "GitHub",
    icon: "ri-github-fill",
    color: "from-gray-700 to-gray-900 dark:from-gray-600 dark:to-gray-800",
    link: "https://github.com/pansir0290",
  },
  {
    name: "QQ",
    icon: "ri-qq-fill",
    color: "from-blue-400 to-indigo-600",
    link: "tencent://message/?uin=YOUR_QQ",
  },
  {
    name: "邮箱",
    icon: "ri-mail-fill",
    color: "from-amber-400 to-red-500",
    link: "mailto:your_email@example.com",
  },
  {
    name: "X / Twitter",
    icon: "ri-twitter-x-fill",
    color: "from-gray-800 to-black dark:from-gray-100 dark:to-white dark:text-black",
    link: "https://x.com/",
  },
  {
    name: "RSS",
    icon: "ri-rss-fill",
    color: "from-orange-400 to-amber-500",
    link: "/rss.xml",
  },
];
---

<!-- 彻底干掉 border-b，增加 pb-4 让圆圈与下方第一个帖子产生自然留白 -->
<div class="w-full pt-1 pb-4 px-3 bg-base-100">
  <div class="flex items-center space-x-4 overflow-x-auto scrollbar-none px-1">
    {
      socialLinks.map((item) => (
        <a
          href={item.link}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center flex-shrink-0 group cursor-pointer focus:outline-none"
        >
          <div class="p-[2.5px] rounded-full bg-gradient-to-tr from-amber-500 via-rose-500 to-purple-600 group-hover:scale-105 transition-transform duration-200">
            <div class="p-[2px] bg-base-100 rounded-full">
              <div class={`w-16 h-16 sm:w-18 sm:h-18 rounded-full bg-gradient-to-br ${item.color} flex items-center justify-center text-white text-2xl sm:text-3xl shadow-sm`}>
                <i class={item.icon} />
              </div>
            </div>
          </div>
          <span class="text-xs text-base-content/80 mt-1.5 font-normal tracking-tight truncate max-w-[72px] text-center group-hover:text-primary transition-colors">
            {item.name}
          </span>
        </a>
      ))
    }
  </div>
</div>
