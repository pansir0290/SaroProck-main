---
// src/components/FuwariProfile.astro
const socialLinks = [
  {
    name: "TG 频道",
    icon: "ri-telegram-fill",
    color: "from-sky-400 to-blue-500",
    link: "https://t.me/pansir029",
  },
  {
    name: "GitHub",
    icon: "ri-github-fill",
    color: "from-gray-700 to-gray-900 dark:from-gray-600 dark:to-gray-800",
    link: "https://github.com/pansir0290",
  },
  {
    name: "QQ",
    icon: "ri-qq-fill",
    color: "from-blue-400 to-indigo-600",
    link: "tencent://message/?uin=你的QQ号",
  },
  {
    name: "邮箱",
    icon: "ri-mail-fill",
    color: "from-amber-400 to-red-500",
    link: "mailto:你的邮箱@example.com",
  },
  {
    name: "X / Twitter",
    icon: "ri-twitter-x-fill",
    color: "from-gray-800 to-black dark:from-gray-100 dark:to-white dark:text-black",
    link: "https://x.com/你的推特账号",
  },
  {
    name: "RSS",
    icon: "ri-rss-fill",
    color: "from-orange-400 to-amber-500",
    link: "/rss.xml",
  },
];
---

<div class="w-full py-3 px-4 border-b border-base-content/10 bg-base-100 m-0">
  <div class="flex items-center space-x-4 overflow-x-auto scrollbar-none py-1">
    {
      socialLinks.map((item) => (
        <a
          href={item.link}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center flex-shrink-0 group cursor-pointer focus:outline-none"
        >
          <div class="p-[2px] rounded-full bg-gradient-to-tr from-amber-500 via-rose-500 to-purple-600 group-hover:scale-105 transition-transform duration-200">
            <div class="p-[2px] bg-base-100 rounded-full">
              <div class={`w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-gradient-to-br ${item.color} flex items-center justify-center text-white text-xl sm:text-2xl shadow-sm`}>
                <i class={item.icon} />
              </div>
            </div>
          </div>
          <span class="text-[11px] text-base-content/80 mt-1 font-medium truncate max-w-[64px] text-center group-hover:text-primary transition-colors">
            {item.name}
          </span>
        </a>
      ))
    }
  </div>
</div>
