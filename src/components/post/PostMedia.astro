---
import type { MediaFile } from "@/types";

interface Props {
  media: MediaFile[];
}
const { media } = Astro.props;

if (!media || media.length === 0) return null;

// 随机生成唯一ID，保证多条动态不冲突
const uniqueId = `media-gallery-${Math.random().toString(36).substring(2, 9)}`;
---

<div class="relative group my-3 rounded-xl overflow-hidden bg-black/10 border border-base-content/10">
  
  <!-- 1. 图片滑动轨道 (手机直接左右滑) -->
  <div
    id={uniqueId}
    class="flex overflow-x-auto snap-x snap-mandatory scrollbar-none scroll-smooth aspect-square sm:aspect-[4/3] max-h-[500px]"
  >
    {
      media.map((item, index) => (
        <div class="w-full h-full flex-shrink-0 snap-center flex items-center justify-center bg-black/20 relative">
          {item.type === "image" ? (
            <img
              src={item.url}
              alt={item.alt || "Image content"}
              class="w-full h-full object-contain select-none"
              loading="lazy"
            />
          ) : (
            <video
              src={item.url}
              controls
              preload="metadata"
              playsinline
              class="max-w-full max-h-full object-contain"
            />
          )}
        </div>
      ))
    }
  </div>

  <!-- 2. 右上角页码 (如 1 / 6) -->
  {
    media.length > 1 && (
      <div class="absolute top-3 right-3 bg-black/60 backdrop-blur-md text-white text-[11px] font-mono px-2.5 py-1 rounded-full z-10 pointer-events-none">
        <span class="current-counter">1</span> / {media.length}
      </div>
    )
  }

  <!-- 3. 电脑端左右点击箭头 -->
  {
    media.length > 1 && (
      <>
        <button
          type="button"
          class="prev-btn hidden group-hover:flex absolute left-2 top-1/2 -translate-y-1/2 btn btn-circle btn-xs sm:btn-sm bg-black/50 hover:bg-black/80 text-white border-none backdrop-blur-sm transition-all z-10"
          aria-label="上一张"
          data-target={uniqueId}
        >
          <i class="ri-arrow-left-s-line text-lg" />
        </button>
        <button
          type="button"
          class="next-btn hidden group-hover:flex absolute right-2 top-1/2 -translate-y-1/2 btn btn-circle btn-xs sm:btn-sm bg-black/50 hover:bg-black/80 text-white border-none backdrop-blur-sm transition-all z-10"
          aria-label="下一张"
          data-target={uniqueId}
        >
          <i class="ri-arrow-right-s-line text-lg" />
        </button>
      </>
    )
  }
</div>

<script>
  function setupGallery() {
    // 电脑点击左右切换
    document.querySelectorAll(".prev-btn, .next-btn").forEach((btn) => {
      if (btn.hasAttribute("data-inited")) return;
      btn.setAttribute("data-inited", "true");

      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const targetId = btn.getAttribute("data-target");
        if (!targetId) return;
        const container = document.getElementById(targetId);
        if (!container) return;

        const scrollAmount = container.clientWidth;
        const isNext = btn.classList.contains("next-btn");
        container.scrollBy({ left: isNext ? scrollAmount : -scrollAmount, behavior: "smooth" });
      });
    });

    // 滑动时更新 1/6 页码
    document.querySelectorAll('[id^="media-gallery-"]').forEach((container) => {
      if (container.hasAttribute("data-inited")) return;
      container.setAttribute("data-inited", "true");

      const counter = container.parentElement?.querySelector(".current-counter");
      if (!counter) return;

      container.addEventListener("scroll", () => {
        const width = container.clientWidth;
        if (width <= 0) return;
        const index = Math.round(container.scrollLeft / width) + 1;
        counter.textContent = index.toString();
      });
    });
  }

  // 确保页面加载完/切换页面后都能生效
  document.addEventListener("DOMContentLoaded", setupGallery);
  document.addEventListener("astro:page-load", setupGallery);
</script>

<style>
  .scrollbar-none::-webkit-scrollbar { display: none; }
  .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }
</style>
