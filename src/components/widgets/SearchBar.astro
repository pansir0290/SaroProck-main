
---
import { Icon } from "astro-icon/components";
---

<div class="search-container relative">
  <div
    id="search-bar"
    class="search-bar-collapsed flex items-center rounded-full bg-base-200/80 border border-base-content/10 transition-all duration-300 cursor-text h-8 px-2.5 w-28 sm:w-36"
  >
    <div class="search-icon flex-shrink-0 mr-1.5">
      <Icon name="lucide:search" class="w-3.5 h-3.5 text-base-content/50" />
    </div>
    <input
      type="text"
      id="search-input"
      class="search-input w-full bg-transparent border-none outline-none text-xs py-1 transition-opacity duration-300"
      placeholder="搜索..."
      autocomplete="off"
    />
  </div>

  <!-- 搜索下拉结果 -->
  <div
    id="search-results-dropdown"
    class="search-results-dropdown hidden absolute top-full right-0 mt-2 bg-base-100/95 backdrop-blur-md border border-base-300 rounded-xl shadow-xl z-50 w-screen sm:w-[28rem] md:w-[32rem] max-w-[calc(100vw-2rem)]"
  >
    <!-- 窗口标题栏 -->
    <div
      class="bg-base-200 py-2.5 px-4 flex items-center justify-between border-b border-base-300 rounded-t-xl"
    >
      <div class="flex items-center gap-2">
        <Icon name="lucide:search" class="w-4 h-4 text-primary" />
        <h3 class="font-medium text-sm">搜索结果</h3>
      </div>
      <div class="flex items-center gap-2">
        <div class="dropdown dropdown-end">
          <div tabindex="0" role="button" class="btn btn-xs btn-ghost gap-1">
            <Icon name="lucide:filter" class="w-3.5 h-3.5" />
            <span>筛选</span>
          </div>
          <div
            class="card dropdown-content z-[1] shadow-lg bg-base-200 rounded-xl w-72 mt-2"
          >
            <div class="card-body p-4 gap-3">
              <h6 class="font-semibold text-sm">标签</h6>
              <div class="max-h-40 overflow-y-auto pr-1" id="tag-filters">
                <label class="flex items-center mb-2 text-xs">
                  <input
                    type="checkbox"
                    class="checkbox checkbox-xs checkbox-primary mr-2"
                    value="all"
                    checked
                  />
                  <span>全部</span>
                </label>
              </div>

              <div class="divider my-0.5"></div>

              <h6 class="font-semibold text-sm">分类</h6>
              <div class="max-h-40 overflow-y-auto pr-1" id="category-filters">
                <label class="flex items-center mb-2 text-xs">
                  <input
                    type="checkbox"
                    class="checkbox checkbox-xs checkbox-primary mr-2"
                    value="all"
                    checked
                  />
                  <span>全部</span>
                </label>
              </div>
            </div>
          </div>
        </div>
        <button
          class="btn btn-xs btn-circle btn-ghost text-base-content/70 hover:text-error transition-colors"
          id="close-search-dropdown"
        >
          <Icon name="lucide:x" class="w-4 h-4" />
        </button>
      </div>
    </div>

    <!-- 搜索结果容器 -->
    <div
      id="search-results"
      class="search-results-container p-3 max-h-[60vh] overflow-y-auto"
    >
      <div class="text-base-content/70 text-center py-8">
        <Icon name="lucide:search" class="w-10 h-10 mx-auto mb-2 opacity-20" />
        <p class="text-xs">请输入关键词开始搜索</p>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", initSearch);
  document.addEventListener("astro:page-load", initSearch);

  if (document.readyState !== "loading") {
    initSearch();
  }

  function initSearch() {
    setupSearch();
  }

  function setupSearch() {
    const searchBar = document.getElementById("search-bar") as HTMLElement;
    const searchInput = document.getElementById(
      "search-input",
    ) as HTMLInputElement;
    const searchResultsDropdown = document.getElementById(
      "search-results-dropdown",
    ) as HTMLElement;
    const closeSearchDropdown = document.getElementById(
      "close-search-dropdown",
    ) as HTMLElement;

    if (
      !searchBar ||
      !searchInput ||
      !searchResultsDropdown ||
      !closeSearchDropdown
    )
      return;

    if (searchBar.dataset.searchInitialized === "true") return;
    searchBar.dataset.searchInitialized = "true";

    let isSearchExpanded = false;

    searchBar.addEventListener("click", () => {
      if (!isSearchExpanded) {
        expandSearchBar();
      }
    });

    function expandSearchBar() {
      searchBar.classList.remove("search-bar-collapsed", "w-28", "sm:w-36");
      searchBar.classList.add("search-bar-expanded", "w-36", "sm:w-48");
      searchInput.focus();
      isSearchExpanded = true;

      loadTagsAndCategories();
    }

    function collapseSearchBar() {
      if (!searchInput.value.trim()) {
        searchBar.classList.remove("search-bar-expanded", "w-36", "sm:w-48");
        searchBar.classList.add("search-bar-collapsed", "w-28", "sm:w-36");
        isSearchExpanded = false;
      }

      if (!searchResultsDropdown.classList.contains("hidden")) {
        searchResultsDropdown.classList.add("hidden");
      }
    }

    closeSearchDropdown.addEventListener("click", (e: Event) => {
      e.stopPropagation();
      searchResultsDropdown.classList.add("hidden");
      collapseSearchBar();
    });

    document.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Escape" && isSearchExpanded) {
        collapseSearchBar();
        searchResultsDropdown.classList.add("hidden");
      }
    });

    document.addEventListener("click", (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      const isSearchContainer = target.closest(".search-container");
      if (!isSearchContainer && isSearchExpanded) {
        collapseSearchBar();
      }
    });

    let debounceTimer: number;
    searchInput.addEventListener("input", (e: Event) => {
      const target = e.target as HTMLInputElement;
      clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(() => {
        const query = target.value.trim();

        if (query.length < 1) {
          searchResultsDropdown.classList.add("hidden");
          return;
        }

        searchResultsDropdown.classList.remove("hidden");

        const selectedTags = getSelectedValues("tag-filters");
        const selectedCategories = getSelectedValues("category-filters");

        performSearch(query, selectedTags, selectedCategories);
      }, 300);
    });

    searchInput.addEventListener("focus", () => {
      const query = searchInput.value.trim();
      if (query.length >= 1) {
        searchResultsDropdown.classList.remove("hidden");
      }
    });
  }

  async function loadTagsAndCategories() {
    try {
      const response = await fetch("/api/content-metadata");
      if (!response.ok) throw new Error("Failed to fetch content metadata");

      const { tags, categories } = await response.json();

      const tagFiltersContainer = document.getElementById("tag-filters");
      if (tagFiltersContainer && tags?.length) {
        const allOption = tagFiltersContainer
          .querySelector('input[value="all"]')
          ?.closest("label");
        if (allOption) {
          tagFiltersContainer.innerHTML = "";
          tagFiltersContainer.appendChild(allOption);

          tags.forEach((tag: string) => {
            const label = document.createElement("label");
            label.className = "flex items-center mb-2 text-xs";

            const checkbox = document.createElement("input");
            checkbox.type = "checkbox";
            checkbox.className = "checkbox checkbox-xs checkbox-primary mr-2";
            checkbox.value = tag;

            const span = document.createElement("span");
            span.textContent = tag;

            label.appendChild(checkbox);
            label.appendChild(span);
            tagFiltersContainer.appendChild(label);
          });
        }
      }

      const categoryFiltersContainer =
        document.getElementById("category-filters");
      if (categoryFiltersContainer && categories?.length) {
        const allOption = categoryFiltersContainer
          .querySelector('input[value="all"]')
          ?.closest("label");
        if (allOption) {
          categoryFiltersContainer.innerHTML = "";
          categoryFiltersContainer.appendChild(allOption);

          categories.forEach((category: string) => {
            const label = document.createElement("label");
            label.className = "flex items-center mb-2 text-xs";

            const checkbox = document.createElement("input");
            checkbox.type = "checkbox";
            checkbox.className = "checkbox checkbox-xs checkbox-primary mr-2";
            checkbox.value = category;

            const span = document.createElement("span");
            span.textContent = category;

            label.appendChild(checkbox);
            label.appendChild(span);
            categoryFiltersContainer.appendChild(label);
          });
        }
      }

      setupCheckboxLogic("tag-filters");
      setupCheckboxLogic("category-filters");

      document
        .querySelectorAll("#tag-filters input, #category-filters input")
        .forEach((checkbox) => {
          checkbox.addEventListener("change", () => {
            const searchInput = document.getElementById(
              "search-input",
            ) as HTMLInputElement;
            if (!searchInput) return;

            const query = searchInput.value.trim();
            if (query.length >= 1) {
              const selectedTags = getSelectedValues("tag-filters");
              const selectedCategories = getSelectedValues("category-filters");
              performSearch(query, selectedTags, selectedCategories);
            }
          });
        });
    } catch (error) {
      console.error("Error loading tags and categories:", error);
    }
  }

  function setupCheckboxLogic(containerId: string) {
    const container = document.getElementById(containerId);
    if (!container) return;

    const allCheckbox = container.querySelector(
      'input[value="all"]',
    ) as HTMLInputElement;
    const otherCheckboxes = Array.from(
      container.querySelectorAll('input[type="checkbox"]:not([value="all"])'),
    ) as HTMLInputElement[];

    allCheckbox?.addEventListener("change", () => {
      if (allCheckbox.checked) {
        otherCheckboxes.forEach((cb) => {
          cb.checked = false;
        });
      }
    });

    otherCheckboxes.forEach((checkbox) => {
      checkbox.addEventListener("change", () => {
        const anyOtherChecked = otherCheckboxes.some((cb) => cb.checked);
        if (allCheckbox) allCheckbox.checked = !anyOtherChecked;

        if (!anyOtherChecked && allCheckbox) {
          allCheckbox.checked = true;
        }
      });
    });
  }

  function getSelectedValues(containerId: string): string[] {
    const container = document.getElementById(containerId);
    if (!container) return [];

    const allCheckbox = container.querySelector(
      'input[value="all"]',
    ) as HTMLInputElement;
    if (allCheckbox?.checked) return [];

    return Array.from(
      container.querySelectorAll('input[type="checkbox"]:checked'),
    ).map((cb: Element) => (cb as HTMLInputElement).value);
  }

  async function performSearch(
    query: string,
    tags: string[],
    categories: string[],
  ) {
    const searchResults = document.getElementById("search-results");
    if (!searchResults) return;

    searchResults.innerHTML = `
      <div class="flex flex-col items-center justify-center py-8">
        <span class="loading loading-spinner loading-md mb-2"></span>
        <p class="text-xs text-base-content/70">搜索中...</p>
      </div>
    `;

    try {
      const keywords = query
        .trim()
        .split(/\s+/)
        .filter((keyword) => keyword.length >= 1);

      if (keywords.length === 0) {
        searchResults.innerHTML = `
          <div class="text-center py-8">
            <p class="text-xs text-base-content/70">请输入有效关键词</p>
          </div>
        `;
        return;
      }

      const response = await fetch("/api/search", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          query,
          tags: tags.length > 0 ? tags : undefined,
          categories: categories.length > 0 ? categories : undefined,
        }),
      });

      if (!response.ok) throw new Error("Search request failed");

      const results = await response.json();

      if (!Array.isArray(results) || results.length === 0) {
        searchResults.innerHTML = `
          <div class="text-center py-8 text-xs text-base-content/70">
            没有匹配的结果
          </div>
        `;
        return;
      }

      const resultsHtml = results
        .map(
          (result: any) => `
        <a href="${result.url}" class="search-result block p-2.5 mb-2 hover:bg-base-200 rounded-lg transition-colors duration-300 border-l-2 border-transparent hover:border-primary group">
          <h3 class="font-medium text-sm text-base-content group-hover:text-primary transition-colors">${highlightMatch(result.title, result.keywords || [query])}</h3>
          ${
            result.snippet
              ? `<p class="text-xs text-base-content/70 mt-1 line-clamp-2">${highlightMatch(result.snippet, result.keywords || [query])}</p>`
              : ""
          }
          <div class="flex flex-wrap gap-1 mt-2">
            ${(result.categories || [])
              .map(
                (category: string) =>
                  `<span class="badge badge-xs badge-neutral">${highlightMatch(category, result.keywords || [query])}</span>`,
              )
              .join("")}
            ${(result.tags || [])
              .map(
                (tag: string) =>
                  `<span class="badge badge-xs badge-outline">${highlightMatch(tag, result.keywords || [query])}</span>`,
              )
              .join("")}
          </div>
        </a>
      `,
        )
        .join("");

      searchResults.innerHTML = resultsHtml;
    } catch (error) {
      console.error("Error performing search:", error);
      searchResults.innerHTML = `
        <div class="text-center py-8 text-xs text-error">
          搜索失败，请稍后再试
        </div>
      `;
    }
  }

  function highlightMatch(text: string, keywords: string[]): string {
    if (!text) return "";

    let result = text;
    const activeKeywords = keywords && keywords.length > 0 ? keywords : [];

    activeKeywords
      .slice()
      .sort((a, b) => b.length - a.length)
      .forEach((keyword) => {
        if (!keyword) return;
        const escapedKeyword = keyword.replace(
          /[.*+?^${}()|[\]\\]/g,
          "\\$&",
        );
        const regex = new RegExp(`(${escapedKeyword})`, "gi");
        result = result.replace(regex, '<mark class="bg-primary/20 text-primary px-0.5 rounded">$1</mark>');
      });

    return result;
  }
</script>

<style>
  .search-bar-collapsed {
    transition: width 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .search-bar-expanded {
    transition: width 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .search-input {
    opacity: 0.8;
  }

  .search-bar-expanded .search-input {
    opacity: 1;
  }

  .search-results-dropdown {
    animation: slideDown 0.2s ease-out forwards;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .search-results-container {
    scrollbar-width: thin;
  }
</style>
