---
import type { TelegramPost } from "@/types";
import MediaGallery from "./MediaGallery.astro";
import LinkPreview from "./LinkPreview.astro";
import Comments from "@components/comments/Comments.astro";
import LikeButton from "./LikeButton.tsx";

interface Props {
  post: TelegramPost;
  isLastItem?: boolean;
}
const { post, isLastItem = false } = Astro.props;
---

<article class="dynamic-item my-8 border-b border-base-content/10 pb-6">
  <div class="relative w-full">
    <!-- 1. 顶部：头像 + 用户名 + 时间 -->
    <div class="flex items-center justify-between mb-3 px-1 sm:px-0">
      <div class="flex items-center space-x-3">
        <div class="avatar">
          <div class="w-10 h-10 rounded-full ring-1 ring-primary/30 ring-offset-1 ring-offset-base-100">
            <img src="/avatar.webp" alt="Channel Avatar" />
          </div>
        </div>
        <div>
          <a href={`/post/${post.id}`} class="font-semibold text-sm text-base-content hover:text-primary transition-colors block">
            サンpansir的随笔
          </a>
          <span class="text-[11px] text-base-content/50 font-mono">{post.formattedDate}</span>
        </div>
      </div>
    </div>

    <!-- 2. 引用回复 -->
    {
      post.reply && (
        <div class="mb-3 px-1 sm:px-0">
          <a href={post.reply.url} class="block not-prose no-underline group/reply">
            <blockquote class="text-xs p-2.5 bg-base-200/60 rounded-lg border-l-2 border-primary group-hover/reply:bg-base-200 transition-colors">
              <p class="font-bold text-base-content">{post.reply.author}</p>
              <p class="opacity-70 truncate text-base-content/80">{post.reply.text}</p>
            </blockquote>
          </a>
        </div>
      )
    }

    <!-- 3. 文字内容 -->
    {
      post.htmlContent && (
        <div
          class="prose prose-sm max-w-none mb-3 px-1 sm:px-0 text-base-content/90 text-sm leading-relaxed"
          set:html={post.htmlContent}
        />
      )
    }

    <!-- 4. 媒体大图区域：用负边距 (-mx-4 或 -mx-3) 强行“撞爆”左右边缘，实现小红书通栏沉浸感 -->
    {
      post.media && post.media.length > 0 && (
        <div class="-mx-4 sm:-mx-6 my-3 w-[calc(100%+2rem)] sm:w-[calc(100%+3rem)]">
          <MediaGallery media={post.media} postId={post.id} />
        </div>
      )
    }

    <!-- 5. 链接预览 -->
    {post.linkPreview && (
      <div class="my-3 px-1 sm:px-0">
        <LinkPreview link={post.linkPreview} />
      </div>
    )}

    <!-- 6. 底部互动与评论 -->
    <div class="px-1 sm:px-0 mt-3">
      <footer class="flex items-center justify-between pt-2 text-xs text-base-content/60">
        <div class="flex items-center space-x-1">
          <i class="ri-bar-chart-line text-sm opacity-70"></i>
          <span>{post.views}</span>
        </div>
        <div class="relative z-10 flex items-center space-x-1">
          <LikeButton postId={post.id} client:visible />
        </div>
      </footer>

      <div class="mt-2 pt-2">
        <Comments
          identifier={post.id}
          commentType="telegram"
          displayMode="compact"
        />
      </div>
    </div>
  </div>
</article>
