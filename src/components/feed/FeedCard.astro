---
import type { TelegramPost } from "@/types";
import MediaGallery from "./MediaGallery.astro";
import LinkPreview from "./LinkPreview.astro";
import Comments from "@components/comments/Comments.astro";
import LikeButton from "./LikeButton.tsx";

interface Props {
  post: TelegramPost;
  isLastItem?: boolean;
}
const { post, isLastItem = false } = Astro.props;
---

<article class="dynamic-item group my-6">
  <div class="grid grid-cols-[auto_1fr] gap-3">
    <!-- 左侧头像与时间轴 -->
    <div class="flex flex-col items-center">
      <div class="avatar mb-2">
        <div
          class="w-8 h-8 rounded-full ring-1 ring-primary/20 ring-offset-1 ring-offset-base-100 group-hover:ring-primary/40 transition-all duration-300"
        >
          <img src="/avatar.webp" alt="Channel Avatar" />
        </div>
      </div>
      {
        !isLastItem && (
          <div class="w-0.5 flex-1 bg-primary/20 rounded-full min-h-[1.5rem]" />
        )
      }
    </div>

    <!-- 右侧内容主卡片：关键点是移除了 overflow-hidden，允许内容与图片向外延伸 -->
    <div
      class="relative transition-all duration-300"
    >
      <!-- 头部：作者与时间 -->
      <div class="flex items-center justify-between mb-2 px-1">
        <a href={`/post/${post.id}`} class="font-medium text-sm text-base-content hover:text-primary transition-colors">
          サンpansir的随笔
        </a>
        <span class="text-xs text-base-content/50 font-mono">{post.formattedDate}</span>
      </div>

      <!-- 引用回复 -->
      {
        post.reply && (
          <a
            href={post.reply.url}
            class="block not-prose no-underline mb-3 group/reply"
          >
            <blockquote class="text-xs p-2.5 bg-base-200/50 backdrop-blur-sm rounded-lg border-l-2 border-primary group-hover/reply:bg-base-200/80 transition-colors">
              <p class="font-bold text-base-content">{post.reply.author}</p>
              <p class="opacity-70 truncate text-base-content/80">
                {post.reply.text}
              </p>
            </blockquote>
          </a>
        )
      }

      <!-- 文字内容 -->
      <div
        class="prose prose-sm max-w-none mb-3 text-base-content/90 text-sm leading-relaxed px-1"
        set:html={post.htmlContent}
      />

      <!-- 媒体相册：通透感的核心！直接突破边界 -->
      <div class="-mx-2 sm:-mx-4 my-3">
        <MediaGallery media={post.media} postId={post.id} />
      </div>

      <!-- 链接预览 -->
      {post.linkPreview && <LinkPreview link={post.linkPreview} />}

      <!-- 底部互动栏 -->
      <footer
        class="flex items-center justify-between pt-2 px-1 mt-2 text-xs text-base-content/60"
      >
        <div class="flex items-center space-x-1">
          <i class="ri-bar-chart-line text-sm opacity-70"></i>
          <span>{post.views}</span>
        </div>
        <div class="relative z-10 flex items-center space-x-1">
          <LikeButton postId={post.id} client:visible />
        </div>
      </footer>

      <!-- 评论区 -->
      <div class="mt-3 pt-2">
        <Comments
          identifier={post.id}
          commentType="telegram"
          displayMode="compact"
        />
      </div>
    </div>
  </div>
</article>
