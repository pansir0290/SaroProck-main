---
import type { TelegramPost } from "@/types";
import MediaGallery from "./MediaGallery.astro";
import LinkPreview from "./LinkPreview.astro";
import Comments from "@components/comments/Comments.astro";
import LikeButton from "./LikeButton.tsx";

interface Props {
  post: TelegramPost;
  isLastItem?: boolean;
}
const { post, isLastItem = false } = Astro.props;
---

<!-- 核心修改：使用 relative left-1/2 -translate-x-1/2 w-screen，强行破开父容器 Padding 做到绝对满屏 -->
<article class="dynamic-item my-6 relative left-1/2 -translate-x-1/2 w-screen sm:static sm:translate-x-0 sm:w-full">
  <div
    class="relative w-full bg-base-100 sm:bg-base-200/40 sm:backdrop-blur-md sm:rounded-2xl border-y sm:border border-base-content/10 overflow-hidden shadow-none sm:shadow-sm"
  >
    <!-- 1. 顶部栏：头像 + 姓名 + 时间 -->
    <div class="flex items-center justify-between px-4 pt-3.5 pb-2.5">
      <div class="flex items-center space-x-3">
        <div class="avatar">
          <div class="w-9 h-9 rounded-full ring-1 ring-primary/30 ring-offset-1 ring-offset-base-100">
            <img src="/avatar.webp" alt="Channel Avatar" />
          </div>
        </div>
        <div>
          <a href={`/post/${post.id}`} class="font-semibold text-sm text-base-content hover:text-primary transition-colors block">
            サンpansir的随笔
          </a>
          <span class="text-[11px] text-base-content/50 font-mono">{post.formattedDate}</span>
        </div>
      </div>
    </div>

    <!-- 2. 引用回复 -->
    {
      post.reply && (
        <div class="px-4 mb-2">
          <a href={post.reply.url} class="block not-prose no-underline group/reply">
            <blockquote class="text-xs p-2.5 bg-base-200/70 rounded-lg border-l-2 border-primary group-hover/reply:bg-base-200 transition-colors">
              <p class="font-bold text-base-content">{post.reply.author}</p>
              <p class="opacity-70 truncate text-base-content/80">{post.reply.text}</p>
            </blockquote>
          </a>
        </div>
      )
    }

    <!-- 3. 文字内容 -->
    {
      post.htmlContent && (
        <div
          class="prose prose-sm max-w-none px-4 mb-3 text-base-content/90 text-sm leading-relaxed"
          set:html={post.htmlContent}
        />
      )
    }

    <!-- 4. 媒体大图区域 -->
    {
      post.media && post.media.length > 0 && (
        <div class="w-full my-2">
          <MediaGallery media={post.media} postId={post.id} />
        </div>
      )
    }

    <!-- 5. 链接预览 -->
    {post.linkPreview && (
      <div class="px-4 my-2">
        <LinkPreview link={post.linkPreview} />
      </div>
    )}

    <!-- 6. 底部互动栏与评论区 -->
    <div class="px-4 pb-3">
      <footer class="flex items-center justify-between pt-3 border-t border-base-content/10 text-xs text-base-content/60">
        <div class="flex items-center space-x-1">
          <i class="ri-bar-chart-line text-sm opacity-70"></i>
          <span>{post.views}</span>
        </div>
        <div class="relative z-10 flex items-center space-x-1">
          <LikeButton postId={post.id} client:visible />
        </div>
      </footer>

      <div class="mt-2 pt-2">
        <Comments
          identifier={post.id}
          commentType="telegram"
          displayMode="compact"
        />
      </div>
    </div>
  </div>
</article>
