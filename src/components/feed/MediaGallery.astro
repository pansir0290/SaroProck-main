---
import type { MediaFile } from "@/types";

interface Props {
  media?: MediaFile[];
  postId?: string;
}

const { media, postId } = Astro.props;

if (!media || media.length === 0) return null;

const uniqueId = `gallery-${postId || Math.random().toString(36).substring(2, 9)}`;
---

<div class="relative group w-full overflow-hidden block m-0 p-0 leading-none media-gallery-root">
  <!-- 滚动轨道 -->
  <div
    id={uniqueId}
    class="flex overflow-x-auto snap-x snap-mandatory scrollbar-none scroll-smooth w-full m-0 p-0 leading-none border-none transform-gpu"
  >
    {
      media.map((item, index) => (
        <div 
          class="w-full flex-shrink-0 snap-center flex items-center justify-center relative aspect-[4/5] m-0 p-0 overflow-hidden border-none outline-none bg-base-100"
        >
          {item.type === "image" ? (
            <img
              src={item.url}
              alt={item.alt || `Media ${index + 1}`}
              class="w-full h-full object-cover select-none block m-0 p-0 border-0 outline-none scale-[1.015] transform-gpu transition-transform duration-200"
              loading="lazy"
            />
          ) : (
            <!-- 懒加载与内存回收视频容器 -->
            <div class="relative w-full h-full group/video overflow-hidden cursor-pointer flex items-center justify-center lazy-video-container">
              <video
                data-src={item.url}
                muted
                loop
                playsinline
                preload="none"
                class="reel-video w-full h-full object-cover block m-0 p-0 border-0 outline-none scale-[1.015] transform-gpu"
              />
              <!-- 视频悬浮微弱播放图标指示器 -->
              <div class="pointer-events-none absolute inset-0 flex items-center justify-center bg-black/10 opacity-0 group-hover/video:opacity-100 transition-opacity duration-200">
                <i class="ri-play-circle-line text-white/80 text-4xl shadow-lg"></i>
              </div>
            </div>
          )}
        </div>
      ))
    }
  </div>

  <!-- 1. 右上角悬浮胶囊页码（如 1/5） -->
  {
    media.length > 1 && (
      <div class="absolute top-3 right-3 bg-black/60 backdrop-blur-md text-white text-[11px] font-mono px-2.5 py-1 rounded-full z-10 pointer-events-none border border-white/10 shadow-md">
        <span class="current-counter">1</span> / {media.length}
      </div>
    )
  }

  <!-- 2. PC 端左右悬浮箭头 -->
  {
    media.length > 1 && (
      <>
        <button
          type="button"
          class="prev-btn hidden group-hover:flex absolute left-3 top-1/2 -translate-y-1/2 btn btn-circle btn-sm bg-black/50 hover:bg-black/80 text-white border-none backdrop-blur-sm transition-all z-10"
          aria-label="上一张"
          data-target={uniqueId}
        >
          <i class="ri-arrow-left-s-line text-lg" />
        </button>
        <button
          type="button"
          class="next-btn hidden group-hover:flex absolute right-3 top-1/2 -translate-y-1/2 btn btn-circle btn-sm bg-black/50 hover:bg-black/80 text-white border-none backdrop-blur-sm transition-all z-10"
          aria-label="下一张"
          data-target={uniqueId}
        >
          <i class="ri-arrow-right-s-line text-lg" />
        </button>
      </>
    )
  }
</div>

<!-- 3. Ins 风格：底部动态圆点指示器（Dots Indicator） -->
{
  media.length > 1 && (
    <div class="w-full flex items-center justify-center space-x-1.5 py-2 bg-base-100 border-none select-none gallery-dots-wrapper">
      {media.map((_, idx) => (
        <span
          class={`gallery-dot dot-${uniqueId} inline-block rounded-full transition-all duration-300 ${
            idx === 0
              ? "w-1.5 h-1.5 bg-primary scale-125"
              : "w-1.5 h-1.5 bg-base-content/20"
          }`}
          data-index={idx}
        />
      ))}
    </div>
  )
}

<script>
  function initBleedGallery() {
    // 1. 左右按钮点击切换
    document.querySelectorAll(".prev-btn, .next-btn").forEach((btn) => {
      if (btn.hasAttribute("data-inited")) return;
      btn.setAttribute("data-inited", "true");

      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();

        const targetId = btn.getAttribute("data-target");
        if (!targetId) return;
        const container = document.getElementById(targetId);
        if (!container) return;

        const scrollAmount = container.clientWidth;
        const isNext = btn.classList.contains("next-btn");

        container.scrollBy({
          left: isNext ? scrollAmount : -scrollAmount,
          behavior: "smooth",
        });
      });
    });

    // 2. 监听滑动：同时更新胶囊数字 和 底部小圆点高亮状态
    document.querySelectorAll('[id^="gallery-"]').forEach((container) => {
      if (container.hasAttribute("data-inited")) return;
      container.setAttribute("data-inited", "true");

      const targetId = container.id;
      const article = container.closest("article") || container.parentElement?.parentElement;
      const counter = article ? article.querySelector(".current-counter") : null;
      const dots = article ? article.querySelectorAll(`.dot-${targetId}`) : document.querySelectorAll(`.dot-${targetId}`);

      container.addEventListener("scroll", () => {
        const width = container.clientWidth;
        if (width <= 0) return;
        
        const index = Math.round(container.scrollLeft / width);
        
        if (counter) {
          counter.textContent = (index + 1).toString();
        }

        dots.forEach((dot, idx) => {
          if (idx === index) {
            dot.className = `gallery-dot dot-${targetId} inline-block w-1.5 h-1.5 rounded-full bg-primary scale-125 transition-all duration-300`;
          } else {
            dot.className = `gallery-dot dot-${targetId} inline-block w-1.5 h-1.5 rounded-full bg-base-content/20 transition-all duration-300`;
          }
        });
      });
    });

    // 3. 核心双向策略：前置硬直出 + 视口懒加载 + 滚出视口内存回收（GC）
    const videoContainers = Array.from(document.querySelectorAll(".lazy-video-container"));
    if (videoContainers.length > 0) {
      // 保持你认可的 5 个首屏硬直出配额
      const INSTANT_LOAD_COUNT = 5; 

      videoContainers.forEach((container, idx) => {
        if (idx < INSTANT_LOAD_COUNT && !container.hasAttribute("data-loaded")) {
          container.setAttribute("data-loaded", "true");
          const video = container.querySelector("video");
          if (video && !video.getAttribute("src")) {
            const realSrc = video.getAttribute("data-src");
            if (realSrc) {
              setTimeout(() => {
                video.setAttribute("src", realSrc);
                video.load();
                video.play().catch(() => {});
              }, idx * 50);
            }
          }
        }
      });

      // 使用双向 IntersectionObserver：既负责进视口加载，又负责出视口释放内存
      if ("IntersectionObserver" in window) {
        const videoObserver = new IntersectionObserver((entries) => {
          // 自上而下排序队列
          entries.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

          entries.forEach((entry, index) => {
            const container = entry.target as HTMLElement;
            const video = container.querySelector("video");
            if (!video) return;

            if (entry.isIntersecting) {
              // 【进入视口】：加载并播放
              if (!container.hasAttribute("data-loaded")) {
                container.setAttribute("data-loaded", "true");
                const realSrc = video.getAttribute("data-src");
                if (realSrc && !video.getAttribute("src")) {
                  setTimeout(() => {
                    video.setAttribute("src", realSrc);
                    video.load();
                    video.play().catch(() => {});
                  }, index * 80);
                }
              } else {
                // 如果之前加载过但被回收了，再次进入时恢复播放
                if (video.paused && video.getAttribute("src")) {
                  video.play().catch(() => {});
                }
              }
            } else {
              // 【滚出视口（上下离开 800px 缓冲区）】：主动释放内存与解码槽位
              // 防止往下刷几页后手机内存爆炸、解码器卡死
              const rect = container.getBoundingClientRect();
              // 只有当元素彻底离开视口上下方较远距离时才回收
              if (rect.top > window.innerHeight + 800 || rect.bottom < -800) {
                if (container.hasAttribute("data-loaded") && video.getAttribute("src")) {
                  video.pause();
                  video.removeAttribute("src"); // 彻底清空 src，释放网络和内存缓存
                  video.load(); // 重置视频解码器状态
                  container.removeAttribute("data-loaded"); // 允许下次滚动回来时重新加载
                }
              }
            }
          });
        }, {
          rootMargin: "600px 0px",
          threshold: 0
        });

        videoContainers.forEach((container) => {
          videoObserver.observe(container);
        });
      }
    }
  }

  (window as any).initBleedGallery = initBleedGallery;

  document.addEventListener("DOMContentLoaded", initBleedGallery);
  document.addEventListener("astro:page-load", initBleedGallery);
</script>

<style>
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
