---
import type { TelegramPost } from "@/types";
import MediaGallery from "./MediaGallery.astro";
import LinkPreview from "./LinkPreview.astro";
import Comments from "@components/comments/Comments.astro";
import LikeButton from "./LikeButton.tsx";

interface Props {
  post: TelegramPost;
  isLastItem?: boolean;
}
const { post, isLastItem = false } = Astro.props;
---

<!-- 外层：干掉顶部所有边框，底部保留极细分隔线；溢出隐藏防止图片溢出像素白边 -->
<article class="w-full bg-base-100 border-t-0 border-b border-base-content/10 m-0 p-0 rounded-none shadow-none overflow-hidden">
  
  <!-- 1. 头部：头像 + 名字 + 时间 -->
  <div class="flex items-center justify-between px-3 pt-2 pb-1.5 sm:px-4">
    <div class="flex items-center space-x-2 min-w-0">
      <a href={`/post/${post.id}`} class="block flex-shrink-0 leading-none">
        <img 
          src="/avatar.webp" 
          alt="Avatar" 
          class="w-7 h-7 rounded-full object-cover block m-0 p-0"
        />
      </a>
      
      <!-- 名字 + 时间 -->
      <div class="flex items-center space-x-1.5 text-xs sm:text-sm truncate leading-none">
        <a href={`/post/${post.id}`} class="font-bold text-base-content hover:text-primary transition-colors truncate">
          サンpansir的随笔
        </a>
        <span class="text-base-content/40 text-[10px]">•</span>
        <span class="text-base-content/50 text-[11px] font-mono">
          {post.formattedDate}
        </span>
      </div>
    </div>

    <!-- 右侧三点 -->
    <button aria-label="More options" class="text-base-content/40 hover:text-base-content p-0.5">
      <i class="ri-more-fill text-base"></i>
    </button>
  </div>

  <!-- 2. 引用回复 -->
  {
    post.reply && (
      <div class="px-3 sm:px-4 my-1">
        <a href={post.reply.url} class="block not-prose no-underline group/reply">
          <blockquote class="text-xs p-2 bg-base-200/70 rounded border-l-2 border-primary">
            <p class="font-bold text-base-content">{post.reply.author}</p>
            <p class="opacity-70 truncate text-base-content/80">{post.reply.text}</p>
          </blockquote>
        </a>
      </div>
    )
  }

  <!-- 3. 媒体图片展示（调整至文字上方，m-0 p-0 leading-none 彻底干掉所有白边） -->
  {
    post.media && post.media.length > 0 && (
      <div class="w-full block m-0 p-0 leading-none overflow-hidden select-none">
        <MediaGallery media={post.media} postId={post.id} />
      </div>
    )
  }

  <!-- 4. 交互栏（点赞、分享、收藏） -->
  <div class="px-3 sm:px-4 pt-2 pb-1 flex items-center justify-between">
    <div class="flex items-center space-x-3.5">
      <div class="relative z-10 flex items-center">
        <LikeButton postId={post.id} client:visible />
      </div>

      <button aria-label="Share" class="text-base-content hover:text-primary transition-colors">
        <i class="ri-send-plane-line text-lg"></i>
      </button>

      <div class="flex items-center space-x-1 text-[11px] text-base-content/50">
        <i class="ri-bar-chart-line text-xs opacity-70"></i>
        <span>{post.views}</span>
      </div>
    </div>

    <button aria-label="Bookmark" class="text-base-content hover:text-primary transition-colors">
      <i class="ri-bookmark-line text-lg"></i>
    </button>
  </div>

  <!-- 5. 文字内容区（完美移至图片和交互栏下方，紧贴评论区） -->
  {
    post.htmlContent && (
      <div
        class="prose prose-sm max-w-none px-3 sm:px-4 py-1 text-base-content/90 text-xs sm:text-sm leading-relaxed"
        set:html={post.htmlContent}
      />
    )
  }

  <!-- 6. 链接预览（如果在文字下方） -->
  {post.linkPreview && (
    <div class="px-3 sm:px-4 my-1">
      <LinkPreview link={post.linkPreview} />
    </div>
  )}

  <!-- 7. 评论区（紧贴底部） -->
  <div class="px-3 sm:px-4 pb-2 pt-1">
    <Comments
      identifier={post.id}
      commentType="telegram"
      displayMode="compact"
    />
  </div>

</article>
