---
// src/pages/index.astro
import Layout from "@layouts/Layout.astro";
import TelegramLayout from "@layouts/TelegramLayout.astro";
import FeedCard from "@components/feed/FeedCard.astro";
import { getChannelFeed } from "@/lib/telegram";

const { searchParams } = Astro.url;
const before = searchParams.get("before");
const after = searchParams.get("after");
const q = searchParams.get("q");
const isAjax = searchParams.get("ajax") === "1"; // 🔑 识别后台无限滚动请求

// 🛡️ 终极防呆重定向：
// 只要 URL 带有 before 或 after 参数，且【不是】后台 AJAX 抓取请求，且【不是】搜索场景
// 无论是 ID 48、ID 1 还是任何参数，全部无条件 302 跳转回干净首页 /
if ((before || after) && !q && !isAjax) {
  return Astro.redirect("/", 302);
}

// 正常抓取 Telegram 数据
const { posts } = await getChannelFeed(Astro, {
  before: before || undefined,
  after: after || undefined,
  q: q || undefined,
});

const hasPosts = posts && posts.length > 0;
const beforeCursor = hasPosts ? posts[posts.length - 1].id : null;

// 搜索状态下关闭无限滚动，正常流模式下开启
const enableInfiniteScroll = !q;

let infoMessage = "";
if (q) {
  infoMessage = `正在查看关于 <strong class="text-primary">“${q}”</strong> 的搜索结果。`;
}
---

<Layout title="首页">
  <TelegramLayout>
    {
      infoMessage && (
        <div role="alert" class="alert rounded-xl text-sm mb-4">
          <i class="ri-information-line" />
          <span set:html={infoMessage} />
          <a href="/" class="btn btn-ghost btn-sm ml-auto">
            <i class="ri-arrow-go-back-line mr-1" />
            返回最新
          </a>
        </div>
      )
    }

    <div id="feed-container" class="flex flex-col m-0 p-0 gap-0 space-y-0">
      {
        hasPosts ? (
          posts.map((post, index) => (
            <div 
              id={post.id} 
              data-post-id={post.id} 
              class="scroll-mt-20 m-0 p-0 block w-full"
            >
              <FeedCard post={post} isLastItem={index === posts.length - 1} />
            </div>
          ))
        ) : (
          <div class="text-center text-base-content/60 py-12">
            <i class="ri-compass-3-line text-4xl" />
            <p class="mt-4">没有找到任何动态。</p>
            {q && <p class="text-xs mt-1">请尝试更换搜索关键词。</p>}
          </div>
        )
      }
    </div>

    {
      enableInfiniteScroll && hasPosts && beforeCursor && (
        <div
          id="infinite-scroll-trigger"
          data-before-cursor={beforeCursor}
          class="py-10 text-center text-sm text-base-content/60 flex items-center justify-center gap-2 w-full transition-opacity duration-300 opacity-0 min-h-[80px]"
        >
          <span class="loading loading-spinner loading-md text-primary"></span>
          <span>正在自动加载更多 Ins 动态...</span>
        </div>
      )
    }
  </TelegramLayout>
</Layout>

<script lang="ts">
  let isLoading = false;

  function initInfiniteScroll() {
    const trigger = document.getElementById("infinite-scroll-trigger");
    const container = document.getElementById("feed-container");
    if (!trigger || !container) return;

    const observer = new IntersectionObserver(
      async (entries) => {
        const entry = entries[0];
        const currentBefore = trigger.getAttribute("data-before-cursor");

        if (entry.isIntersecting && !isLoading && currentBefore) {
          isLoading = true;
          
          const loadingTimer = setTimeout(() => {
            trigger.classList.remove("opacity-0");
          }, 300);

          try {
            const nextUrl = `/?before=${currentBefore}&ajax=1`;
            const response = await fetch(nextUrl);
            const htmlText = await response.text();

            const parser = new DOMParser();
            const doc = parser.parseFromString(htmlText, "text/html");

            // 🎯 精准锁死卡片节点：只抓取带有 data-post-id 属性的帖子层
            const newPosts = doc.querySelectorAll("#feed-container [data-post-id]");
            
            if (newPosts.length > 0) {
              let lastPostId = null;

              newPosts.forEach((node) => {
                const postId = node.getAttribute("data-post-id");
                // 过滤防止重复追加已有卡片
                if (postId && !document.getElementById(postId)) {
                  container.appendChild(node.cloneNode(true));
                  lastPostId = postId;
                }
              });

              // 🔑 游标更新策略升级：从新追加的最后一条卡片上直接获取最新的 ID 游标，彻底摆脱 DOMParser 解析漏掉 Trigger 的问题！
              if (lastPostId) {
                trigger.setAttribute("data-before-cursor", lastPostId);
              } else {
                showEndState(trigger, observer);
              }
            } else {
              showEndState(trigger, observer);
            }
          } catch (error) {
            console.error("加载新动态失败:", error);
          } finally {
            clearTimeout(loadingTimer);
            trigger.classList.add("opacity-0");
            isLoading = false;

            // 重新挂载，防止死锁
            observer.unobserve(trigger);
            setTimeout(() => {
              observer.observe(trigger);
            }, 100);
          }
        }
      },
      {
        rootMargin: "0px 0px 2500px 0px",
        threshold: 0.01,
      }
    );

    observer.observe(trigger);
  }

  function showEndState(trigger: HTMLElement, observer: IntersectionObserver) {
    trigger.innerHTML = `
      <div class="text-xs text-base-content/40 py-4">
        <span>🎉 已经到底啦，共展现了所有 Ins 动态</span>
      </div>
    `;
    trigger.classList.remove("opacity-0");
    observer.disconnect();
  }

  function handleHashHighlight() {
    const hash = window.location.hash;
    if (!hash) return;

    const targetId = hash.replace("#", "");
    if (!targetId) return;

    const targetElement = 
      document.getElementById(targetId) || 
      document.querySelector(`[data-post-id="${targetId}"]`);

    if (targetElement) {
      targetElement.scrollIntoView({ behavior: "smooth", block: "center" });
      targetElement.classList.add("ring-2", "ring-primary", "transition-all", "duration-300");
      setTimeout(() => {
        targetElement.classList.remove("ring-2", "ring-primary");
      }, 2500);
    }
  }

  function setup() {
    initInfiniteScroll();
    handleHashHighlight();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setup);
  } else {
    setup();
  }

  window.addEventListener("hashchange", handleHashHighlight);
</script>
