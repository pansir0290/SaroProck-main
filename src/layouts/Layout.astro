---
import "@styles/print.css";
import "@styles/global.css";
import "@styles/background.css";
import "remixicon/fonts/remixicon.css";

import type { MarkdownHeading } from "astro";
import Header from "@components/layout/Header.astro";
import Hero from "@components/layout/Hero.astro";
import Sidebar from "@components/layout/Sidebar.astro";
import Footer from "@components/layout/Footer.astro";
import BackToTop from "@components/widgets/BackToTop.astro";

const SITE_TITLE = "サンpansir的随笔";
const SITE_DESCRIPTION = "一个孤独的地方，散落着一个人的人生碎片";
const SITE_AUTHOR = "pansir029";
const OG_IMAGE_DEFAULT = "/default-social-image.png";
const TWITTER_HANDLE = "@pansir029";
const GITHUB_URL = "https://github.com/pansir0290";
const TELEGRAM_URL = "https://t.me/pansir029";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  headings?: MarkdownHeading[];
  showHero?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = OG_IMAGE_DEFAULT,
  headings = [],
  showHero = title === "首页",
} = Astro.props;

const finalTitle = title === "首页" ? SITE_TITLE : `${title} | ${SITE_TITLE}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={SITE_AUTHOR} />

    <title>{finalTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" href="/favicon.ico" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon-dark.svg"
      media="(prefers-color-scheme: dark)"
    />

    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="zh_CN" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={TWITTER_HANDLE} />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- 💡 引入 HTMX 核心库 -->
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
  </head>
  <!-- 全局强制消除横向溢出，确保移动端没有任何晃动空间 -->
  <body class="bg-base-100 text-base-content min-h-screen relative selection:bg-primary/20 overflow-x-hidden w-full max-w-full">

    <!-- 全局自然过渡背景 -->
    <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none transition-colors duration-500">
      <div class="absolute -top-[10%] -left-[10%] w-[80vw] h-[60vh] rounded-full bg-gradient-to-br from-primary/20 via-purple-500/10 to-transparent blur-[140px] opacity-80"></div>
      <div class="absolute top-[15%] right-0 w-[70vw] h-[60vh] rounded-full bg-gradient-to-bl from-pink-500/15 via-accent/10 to-transparent blur-[160px] opacity-70"></div>
      <div class="absolute top-[50%] -left-[10%] w-[70vw] h-[60vh] rounded-full bg-gradient-to-tr from-primary/10 via-indigo-500/8 to-transparent blur-[160px] opacity-60"></div>
    </div>

    <Header siteTitle={SITE_TITLE} />

    {showHero && <Hero siteDescription={SITE_DESCRIPTION} />}

    <!-- 核心调整：移动端 px-0 + overflow-x-hidden 严防晃动，电脑端 sm:px-6 lg:px-8 -->
    <div
      id="main-content-grid"
      class={`max-w-6xl mx-auto px-0 sm:px-6 lg:px-8 pb-8 relative z-10 overflow-x-hidden ${
        showHero ? "-mt-8 sm:-mt-12" : "pt-8"
      }`}
    >
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-4">
        <main class="lg:col-span-3 min-h-[60vh]">
          <slot />
        </main>

        <Sidebar
          headings={headings}
          author={SITE_AUTHOR}
          twitterHandle={TWITTER_HANDLE}
          githubUrl={GITHUB_URL}
          telegramUrl={TELEGRAM_URL}
        />
      </div>
    </div>

    <Footer
      author={SITE_AUTHOR}
      twitterHandle={TWITTER_HANDLE}
      githubUrl={GITHUB_URL}
      telegramUrl={TELEGRAM_URL}
    />

    <BackToTop />

    <!-- 全局 Ins 沉浸式视频全屏 Overlay -->
    <div 
      id="reel-fullscreen-modal" 
      class="fixed inset-0 z-[9999] bg-black hidden flex-col justify-center items-center select-none touch-none"
    >
      <!-- 右上角关闭按钮 -->
      <button 
        id="close-reel-btn" 
        type="button" 
        class="absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-black/40 text-white flex items-center justify-center text-2xl backdrop-blur-md active:scale-95 transition-transform"
        aria-label="关闭视频"
      >
        <i class="ri-close-line"></i>
      </button>

      <!-- 点击反馈图标（播放 / 暂停 渐隐动画） -->
      <div id="reel-status-icon" class="pointer-events-none absolute z-20 opacity-0 transition-opacity duration-300 transform scale-150">
        <i id="reel-status-i" class="ri-pause-circle-fill text-white/80 text-6xl shadow-2xl"></i>
      </div>

      <!-- 全屏视频承载容器 -->
      <div id="reel-modal-wrapper" class="w-full h-full flex items-center justify-center relative overflow-hidden">
        <!-- 视频会被节点置换动态移入这里 -->
      </div>
    </div>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        // 1. 代码块复制逻辑
        document.querySelectorAll(".btn-copy").forEach((button) => {
          button.addEventListener("click", async () => {
            const codeBlock = button.closest(".saro-code");
            const code = codeBlock.querySelector("code").textContent;
            const copyIcon = button.querySelector(
              ".saro-code-toolbar-copy-icon",
            );
            const successIcon = button.querySelector(
              ".saro-code-toolbar-copy-success",
            );
            try {
              await navigator.clipboard.writeText(code);
              copyIcon.classList.add("hidden");
              successIcon.classList.remove("hidden");
              button.classList.add("copy-success");
              setTimeout(() => {
                copyIcon.classList.remove("hidden");
                successIcon.classList.add("hidden");
                button.classList.remove("copy-success");
              }, 2000);
            } catch (err) {
              console.error("Failed to copy:", err);
            }
          });
        });

        // 2. Ins 沉浸式视频播放控制器初始化
        initInsVideoController();
      });

      function initInsVideoController() {
        const modal = document.getElementById("reel-fullscreen-modal");
        const wrapper = document.getElementById("reel-modal-wrapper");
        const closeBtn = document.getElementById("close-reel-btn");
        const statusIcon = document.getElementById("reel-status-icon");
        const statusI = document.getElementById("reel-status-i");

        if (!modal || !wrapper || !closeBtn) return;

        let isFullscreen = false;
        let currentVideo = null;
        let originalParent = null;
        let touchStartY = 0;

        function showStatusFeedback(isPause) {
          if (!statusIcon || !statusI) return;
          statusI.className = isPause 
            ? "ri-pause-circle-fill text-white/80 text-6xl shadow-2xl" 
            : "ri-play-circle-fill text-white/80 text-6xl shadow-2xl";
          statusIcon.classList.remove("opacity-0");
          setTimeout(() => {
            statusIcon.classList.add("opacity-0");
          }, 400);
        }

        function openFullscreen(video) {
          if (isFullscreen) return;

          isFullscreen = true;
          currentVideo = video;
          originalParent = video.parentElement;

          wrapper.appendChild(video);
          video.classList.remove("object-cover");
          video.classList.add("object-contain", "w-full", "h-full");
          
          // 💡 强力解除静音并触发音频播放
          video.muted = false;
          video.volume = 1.0;

          const playPromise = video.play();
          if (playPromise !== undefined) {
            playPromise.then(() => {
              video.muted = false;
            }).catch(() => {
              // 针对策略拦截进行二次强制解禁
              video.muted = false;
              video.play().catch(() => {});
            });
          }

          modal.classList.remove("hidden");
          modal.classList.add("flex");

          history.pushState({ reelFullscreen: true }, "");
        }

        function exitFullscreen() {
          if (!isFullscreen || !currentVideo || !originalParent) return;

          modal.classList.add("hidden");
          modal.classList.remove("flex");

          originalParent.appendChild(currentVideo);
          currentVideo.classList.remove("object-contain");
          currentVideo.classList.add("object-cover");
          currentVideo.muted = true;
          currentVideo.play().catch(() => {});

          isFullscreen = false;
          currentVideo = null;
          originalParent = null;
        }

        document.addEventListener("click", (e) => {
          const target = e.target;
          if (target && target.classList.contains("reel-video")) {
            const video = target;
            if (!isFullscreen) {
              openFullscreen(video);
            } else {
              if (video.paused) {
                video.play();
                showStatusFeedback(false);
              } else {
                video.pause();
                showStatusFeedback(true);
              }
            }
          }
        });

        closeBtn.addEventListener("click", () => {
          if (isFullscreen) {
            history.back();
          }
        });

        window.addEventListener("popstate", () => {
          if (isFullscreen) {
            exitFullscreen();
          }
        });

        modal.addEventListener("touchstart", (e) => {
          touchStartY = e.touches[0].clientY;
        }, { passive: true });

        modal.addEventListener("touchend", (e) => {
          const touchEndY = e.changedTouches[0].clientY;
          if (touchEndY - touchStartY > 100 && isFullscreen) {
            history.back();
          }
        }, { passive: true });
      }
    </script>
  </body>
</html>
